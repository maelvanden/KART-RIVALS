{
  "expo": {
    "name": "Kart Rivals",
    "slug": "kart-rivals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kartrivals",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "fr.kartrivals.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111418",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kart Rivals utilise ta position pour te montrer les pilotes et le classement de ta région (arrondie à ~1 km, jamais montrée aux autres) et pour placer un circuit sur la carte quand tu signales son emplacement.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kart Rivals accède à tes photos pour choisir ta photo de profil et partager des photos ou vidéos (Actu, Radio Paddock, fiches circuit).",
          "cameraPermission": "Kart Rivals utilise l'appareil photo pour photographier ton ticket de chronométrage et prendre des photos ou vidéos à partager.",
          "microphonePermission": "Kart Rivals utilise le micro pour enregistrer le son des vidéos que tu filmes et partages dans l'Actu."
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0B0D",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "maelvddsh",
    "extra": {
      "eas": {
        "projectId": "8c9d420c-f2b6-4cb2-97ea-b51472cb4a66"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/8c9d420c-f2b6-4cb2-97ea-b51472cb4a66"
    }
  }
}
